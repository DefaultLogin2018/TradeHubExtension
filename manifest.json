{
  "manifest_version": 3,
  "name": "Whisper Extractor with Interface",
  "version": "1.0",
  "description": "Перехватывает ответы API и выводит поле whisper. Управление осуществляется через выдвигающееся меню на странице и через вкладку Hub.",
  "permissions": [
    "activeTab",
    "storage",
    "alarms"
  ],
  "content_scripts": [
    {
      "matches": ["https://www.pathofexile.com/trade2/search/poe2/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js", "sound.mp3"],
      "matches": ["<all_urls>"]
    },
    {
      "resources": ["hub.html", "hub.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
